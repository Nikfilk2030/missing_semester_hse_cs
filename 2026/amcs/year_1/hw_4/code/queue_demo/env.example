# Скопируйте в .env для локального запуска или /etc/cloud-hw4.env для systemd.
# Значения совместимы с source и EnvironmentFile; слово export не требуется.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ru-central1
AWS_EC2_METADATA_DISABLED=true
SQS_ENDPOINT_URL=https://message-queue.api.cloud.yandex.net
S3_ENDPOINT_URL=https://storage.yandexcloud.net
QUEUE_URL=CHANGE_ME
RESULT_BUCKET=CHANGE_ME
RESULT_PREFIX=results/
HOST=0.0.0.0
PORT=8080
# WORKER_ID обычно оставляют незаданным: используется уникальный hostname ВМ.
